From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chanho Park <parkch98@gmail.com>
Date: Thu, 4 Jun 2026 02:00:00 +0900
Subject: [PATCH] measured_boot: use local hash for init measurements

The measured boot partition collects boot measurements from its SFN
initialisation entry point. On the RSE IPC backend this happens before
cross-partition PSA Crypto calls are usable from the init thread, so
the first measurement extend can fail with PSA_ERROR_NOT_SUPPORTED.

Use the local CC3XX PSA hash driver for that init-time SHA-256
calculation when it is available, and keep the PSA Crypto service call
as a fallback for other configurations.

Signed-off-by: Chanho Park <parkch98@gmail.com>
---
 partitions/measured_boot/CMakeLists.txt   |  6 ++++++
 partitions/measured_boot/measured_boot.c | 23 ++++++++++++++++++++++-
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/partitions/measured_boot/CMakeLists.txt b/partitions/measured_boot/CMakeLists.txt
index 21952d3..a73524b 100644
--- a/partitions/measured_boot/CMakeLists.txt
+++ b/partitions/measured_boot/CMakeLists.txt
@@ -35,10 +35,16 @@ target_include_directories(tfm_psa_rot_partition_measured_boot
         ${CMAKE_BINARY_DIR}/generated/secure_fw/partitions/measured_boot
 )
 
+if (CRYPTO_HW_ACCELERATOR_TYPE STREQUAL "cc312")
+    target_compile_definitions(tfm_psa_rot_partition_measured_boot
+        PRIVATE PSA_CRYPTO_DRIVER_CC3XX)
+endif()
+
 target_link_libraries(tfm_psa_rot_partition_measured_boot
     PRIVATE
         platform_s
         tfm_sprt
+        $<$<STREQUAL:${CRYPTO_HW_ACCELERATOR_TYPE},cc312>:crypto_service_cc3xx_psa_driver_api>
         psa_crypto_config
 )
 
diff --git a/partitions/measured_boot/measured_boot.c b/partitions/measured_boot/measured_boot.c
index a21a5d1..516edc7 100644
--- a/partitions/measured_boot/measured_boot.c
+++ b/partitions/measured_boot/measured_boot.c
@@ -12,6 +12,9 @@
 #include "boot_hal.h"
 #include "service_api.h"
 #include "tfm_string.h"
+#if defined(PSA_CRYPTO_DRIVER_CC3XX)
+#include "cc3xx_psa_hash.h"
+#endif
 #include "tfm_log_unpriv.h"
 #include <stdint.h>
 #include <string.h>
@@ -238,6 +241,26 @@ static inline void get_stored_measurement_value(const uint8_t index,
            MEASUREMENT_VALUE_SIZE);
 }
 
+static psa_status_t compute_measurement_hash(const uint8_t *input,
+                                             size_t input_length,
+                                             uint8_t *hash,
+                                             size_t hash_size,
+                                             size_t *hash_len)
+{
+#if defined(PSA_CRYPTO_DRIVER_CC3XX)
+    psa_status_t status;
+
+    status = cc3xx_hash_compute(TFM_MEASURED_BOOT_HASH_ALG, input,
+                                input_length, hash, hash_size, hash_len);
+    if (status != PSA_ERROR_NOT_SUPPORTED) {
+        return status;
+    }
+#endif
+
+    return psa_hash_compute(TFM_MEASURED_BOOT_HASH_ALG, input, input_length,
+                            hash, hash_size, hash_len);
+}
+
 static psa_status_t extend_measurement_value(const uint8_t index,
                                              const uint8_t *measurement,
                                              const size_t measurement_size,
@@ -251,7 +272,7 @@ static psa_status_t extend_measurement_value(const uint8_t index,
     total_size = measurement_size + MEASUREMENT_VALUE_SIZE;
 
     /* Perform hash calculation */
-    return psa_hash_compute(TFM_MEASURED_BOOT_HASH_ALG, temp_buffer,
+    return compute_measurement_hash(temp_buffer,
                               total_size, hash_result, MEASUREMENT_VALUE_SIZE,
                               hash_len);
 }
